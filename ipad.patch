+      };
+      const scrollTo = (p) => {
+        let dx = (last.x - p.x) * gain, dy = (last.y - p.y) * gain;
+        last = p;
+        moved += Math.hypot(dx, dy);
+        if (!axis) {
+          if (moved < 8) return;
