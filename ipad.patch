+/// Commands the page queued for the editor (the Zotero panel in index.html): `window.__wcQueue`
+/// holds `{id, cmd, params}` entries; each answer goes to `window.__wcDone(id, ok, json)`.
+fn run_page_commands(app: &mut WordApp) {
+    let Some(window) = web_sys::window() else { return };
+    let key = wasm_bindgen::JsValue::from_str("__wcQueue");
+    let Ok(queue) = js_sys::Reflect::get(&window, &key) else { return };
+    let Ok(queue) = queue.dyn_into::<js_sys::Array>() else { return };
+    if queue.length() == 0 {
+        return;
