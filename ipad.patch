+    html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #e6e6e6;
+      overscroll-behavior: none; -webkit-tap-highlight-color: transparent; }
+    /* Touch and pen go to the editor only: no browser panning, text selection, callout or magnifier. */
+    #wordcraft_canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block;
+      touch-action: none; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
     #wordcraft_loading { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
       color: #555; font: 14px system-ui, sans-serif; pointer-events: none; }
   </style>
+  <script>
+    // eframe turns both the pointer events and the touch events of one finger or pen touch into
+    // presses, so every tap arrived twice and read as a double-click (a tap selected a word, a
+    // double tap a paragraph). Touch and pen keep only the touch path; the mouse is unchanged.
+    for (const name of ["pointerdown", "pointerup", "pointermove", "pointercancel"]) {
+      window.addEventListener(name, (e) => { if (e.pointerType !== "mouse") e.stopImmediatePropagation(); }, true);
+    }
+  </script>
 </head>
 <body>
   <canvas id="wordcraft_canvas"></canvas>
