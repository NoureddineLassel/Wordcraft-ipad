+            row.className = i === chosen ? "sel" : "";
+            const b = document.createElement("b"); b.textContent = src.title || "(untitled)";
+            row.append(b, document.createElement("br"), document.createTextNode([src.author, src.year].filter(Boolean).join(" · ")));
+            row.addEventListener("click", () => { chosen = i; render(); });
+            $("zt_results").append(row);
+          });
+        };
+        const search = async () => {
+          const q = $("zt_q").value.trim();
+          status("جارٍ البحث…");
+          try {
+            const url = `https://api.zotero.org/users/${encodeURIComponent(store.get("user"))}/items/top?` +
+              new URLSearchParams({ q, qmode: "titleCreatorYear", limit: "40", format: "json", sort: "dateModified", key: store.get("key") });
+            const r = await fetch(url, { headers: { "Zotero-API-Version": "3" } });
+            if (r.status === 403) throw new Error("المفتاح أو رقم المستخدم غير صحيح، أو المفتاح لا يسمح بقراءة المكتبة");
+            if (!r.ok) throw new Error("Zotero: " + r.status);
+            items = (await r.json()).filter((it) => it.data && !["note", "attachment", "annotation"].includes(it.data.itemType));
+            chosen = items.length ? 0 : -1;
+            render();
+            status(items.length ? `${items.length} نتيجة. اختر مرجعًا ثم «إدراج إحالة».` : "لا توجد نتائج.");
+          } catch (e) { status(e.message === "Failed to fetch" ? "تعذّر الاتصال بـ zotero.org" : e.message); }
+        };
+        $("zt_go").addEventListener("click", search);
+        $("zt_q").addEventListener("keydown", (e) => { if (e.key === "Enter") search(); });
+        $("zt_cite").addEventListener("click", async () => {
+          if (chosen < 0) { status("اختر مرجعًا من النتائج أولًا."); return; }
+          const params = { source: toSource(items[chosen]) };
+          const pages = $("zt_pages").value.trim();
+          if (pages) params.pages = pages;
+          try {
+            await run("references.citationStyle", { style: $("zt_style").value });
+            await run("references.citation", params);
+            status("أُدرجت الإحالة في موضع المؤشر.");
+            $("zt_pages").value = "";
+          } catch (e) { status(e.message); }
+        });
+        $("zt_style").addEventListener("change", async () => {
+          store.set("style", $("zt_style").value);
+          try { await run("references.citationStyle", { style: $("zt_style").value }); status("غُيّر النمط لكل الإحالات."); }
