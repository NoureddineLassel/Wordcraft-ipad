+    }
+
+    // Scrolling by touch, sent to the editor as small wheel steps (the editor eases large steps,
+    // which made the page jump): two fingers anywhere on the page, or one finger on the strip at
+    // the right edge. The motion is locked to one direction and keeps gliding after the fingers
+    // lift. One finger elsewhere, or the pen, still places the caret and selects.
+    // A first touch is held back briefly: a second finger landing in that window makes the gesture
+    // a scroll, and the editor never sees a press. Otherwise the press is replayed as a mouse
+    // press and the rest of the touch goes through unchanged.
+    (() => {
+      const HOLD_MS = 140, STRIP_GAIN = 2.5, STEP = 6, FRICTION = 0.94;
+      let mode = "idle"; // idle | pending | single | scroll
+      let start = null, timer = 0, last = null, axis = null, moved = 0, gain = 1;
+      let samples = [], glide = 0;
+      const canvas = () => document.getElementById("wordcraft_canvas");
+      const onCanvas = (e) => e.target === canvas();
+      const mouse = (type, x, y, buttons) => canvas().dispatchEvent(new PointerEvent(type, {
+        bubbles: true, cancelable: true, composed: true, pointerType: "mouse", isPrimary: true,
+        button: 0, buttons, clientX: x, clientY: y }));
+      const center = (touches) => {
+        let x = 0, y = 0;
+        for (const t of touches) { x += t.clientX; y += t.clientY; }
+        return { x: x / touches.length, y: y / touches.length };
+      };
+      // The point the editor scrolls under: the middle of the page area.
+      const aim = () => ({ x: innerWidth / 2, y: innerHeight * 0.6 });
+      const wheel = (dx, dy) => {
+        const p = aim();
+        canvas().dispatchEvent(new MouseEvent("mousemove", { bubbles: true, clientX: p.x, clientY: p.y }));
+        const n = Math.max(1, Math.ceil(Math.hypot(dx, dy) / STEP));
+        for (let i = 0; i < n; i++) {
+          canvas().dispatchEvent(new WheelEvent("wheel", { bubbles: true, cancelable: true, deltaMode: 0,
+            deltaX: dx / n, deltaY: dy / n, clientX: p.x, clientY: p.y }));
+        }
+      };
