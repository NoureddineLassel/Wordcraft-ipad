+  <script>
+    // eframe turns both the pointer events and the touch events of one finger or pen touch into
+    // presses, so every tap arrived twice and read as a double-click (a tap selected a word, a
+    // double tap a paragraph). Touch and pen keep only the touch path; the mouse is unchanged.
+    for (const name of ["pointerdown", "pointerup", "pointermove", "pointercancel"]) {
