+
+  <script>
+    // Zotero on the web: the desktop integration needs the Zotero app on the same computer, which a
+    // browser can't reach. This panel searches the zotero.org library instead (Zotero Web API, with
+    // the user's own key kept in this browser) and adds items as the document's sources, so the
+    // editor's own citations and bibliography (live, any of its styles) cite them.
+    (() => {
+      const store = {
+        get: (k) => { try { return localStorage.getItem("wc_zotero_" + k) || ""; } catch { return ""; } },
+        set: (k, v) => { try { localStorage.setItem("wc_zotero_" + k, v); } catch {} },
+      };
+      let seq = 0;
+      const waiting = new Map();
+      window.__wcQueue = window.__wcQueue || [];
+      window.__wcDone = (id, ok, json) => {
+        const w = waiting.get(id); if (!w) return;
+        waiting.delete(id);
+        let v; try { v = JSON.parse(json); } catch { v = json; }
+        ok ? w.resolve(v) : w.reject(new Error(String(v)));
+      };
+      // Queue a command for the editor and wake it (it runs queued commands on its next frame).
+      const run = (cmd, params) => new Promise((resolve, reject) => {
+        const id = ++seq;
+        waiting.set(id, { resolve, reject });
+        window.__wcQueue.push({ id, cmd, params });
+        const c = document.getElementById("wordcraft_canvas");
+        c.dispatchEvent(new MouseEvent("mousemove", { bubbles: true, clientX: innerWidth / 2, clientY: innerHeight / 2 }));
+        c.dispatchEvent(new MouseEvent("mouseleave"));
+      });
+
+      const KINDS = { book: "book", bookSection: "bookSection", journalArticle: "article", magazineArticle: "periodical",
+        newspaperArticle: "periodical", conferencePaper: "conference", report: "report", thesis: "report",
+        webpage: "website", blogPost: "website", film: "film" };
+      const names = (creators, type) => creators.filter((c) => c.creatorType === type)
+        .map((c) => c.name || [c.lastName, c.firstName].filter(Boolean).join(", ")).join("; ");
+      const toSource = (item) => {
+        const d = item.data, date = (item.meta && item.meta.parsedDate) || d.date || "";
+        const y = (/\d{4}/.exec(date) || [""])[0];
+        return {
+          tag: "Zot" + item.key, kind: KINDS[d.itemType] || "other",
+          author: names(d.creators || [], "author") || names(d.creators || [], "contributor"),
+          editor: names(d.creators || [], "editor"),
+          title: d.title || "", year: y,
+          publisher: d.publisher || d.institution || d.university || "", city: d.place || "",
+          journal: d.publicationTitle || d.bookTitle || d.proceedingsTitle || d.websiteTitle || "",
+          volume: d.volume || "", issue: d.issue || "", pages: d.pages || "", edition: d.edition || "",
+          url: d.url || "", doi: d.DOI || "", accessed: (d.accessDate || "").slice(0, 10),
+        };
+      };
+
+      const STYLES = ["APA", "Chicago", "MLA", "Harvard (Anglia)", "IEEE", "ISO 690 (author-date)", "ISO 690 (numerical)", "Turabian", "GB/T 7714", "GOST (name sort)", "SIST02"];
+      const html = `
+        <h3><span>Zotero</span><button id="zt_close" aria-label="إغلاق">✕</button></h3>
+        <div id="zt_setup">
+          <div class="muted">مرة واحدة فقط: أنشئ مفتاحًا من <a href="https://www.zotero.org/settings/keys/new" target="_blank" rel="noopener">zotero.org/settings/keys/new</a>
+            (اسمح بقراءة المكتبة)، ثم ألصقه هنا. يُحفظ في هذا المتصفح فقط.</div>
+          <input id="zt_key" placeholder="API key" autocomplete="off" autocapitalize="off" spellcheck="false">
+          <button id="zt_save" class="primary">حفظ</button>
+          <div id="zt_setup_status" class="muted"></div>
+        </div>
+        <div id="zt_main">
+          <div class="row"><input id="zt_q" placeholder="ابحث: مؤلف، عنوان، سنة…" enterkeyhint="search"><button id="zt_go" class="primary">بحث</button></div>
+          <div id="zt_results"></div>
+          <div class="row"><input id="zt_pages" placeholder="الصفحات (اختياري)" style="flex:1"><button id="zt_cite" class="primary" style="flex:1.4">إدراج إحالة</button></div>
+          <div class="row"><select id="zt_style">${STYLES.map((s) => `<option>${s}</option>`).join("")}</select><button id="zt_bib" style="flex:1.4">إدراج قائمة المراجع</button></div>
+          <div class="row"><span id="zt_status" class="muted" style="flex:1"></span><button id="zt_reset">تغيير الحساب</button></div>
+        </div>`;
+
+      addEventListener("DOMContentLoaded", () => {
+        const btn = document.createElement("button");
+        btn.id = "zt_button"; btn.textContent = "Zotero";
+        const panel = document.createElement("div");
+        panel.id = "zt_panel"; panel.innerHTML = html;
+        document.body.append(btn, panel);
+        const $ = (id) => document.getElementById(id);
+        let items = [], chosen = -1;
+        const status = (t) => { $("zt_status").textContent = t; };
+        const showSetup = (on) => { $("zt_setup").style.display = on ? "" : "none"; $("zt_main").style.display = on ? "none" : ""; };
+        const refresh = () => showSetup(!(store.get("user") && store.get("key")));
+        $("zt_style").value = store.get("style") || "APA";
+        btn.addEventListener("click", () => { panel.classList.toggle("open"); refresh(); });
+        $("zt_close").addEventListener("click", () => panel.classList.remove("open"));
+        // The key tells which library it opens: no need to ask for the user ID.
+        $("zt_save").addEventListener("click", async () => {
+          const key = $("zt_key").value.trim();
+          $("zt_setup_status").textContent = "جارٍ التحقق من المفتاح…";
+          try {
+            const r = await fetch("https://api.zotero.org/keys/current?" + new URLSearchParams({ key }), { headers: { "Zotero-API-Version": "3" } });
+            if (!r.ok) throw new Error(r.status === 403 || r.status === 404 ? "المفتاح غير صحيح" : "Zotero: " + r.status);
